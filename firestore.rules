rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidLead(data) {
      return data.keys().hasAll(['name', 'email', 'phone', 'submittedAt', 'source', 'calculations'])
        && data.keys().size() == 6
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 100
        && data.phone is string && data.phone.size() >= 10 && data.phone.size() <= 15
        && data.submittedAt is string && data.submittedAt.size() >= 10 && data.submittedAt.size() <= 40
        && data.source is string && data.source.size() >= 1 && data.source.size() <= 50
        && data.calculations is map;
    }

    // Collection definition
    match /quick_calc_leads/{leadId} {
      // Create is public but strictly validated
      allow create: if isValidId(leadId) && isValidLead(request.resource.data);
      
      // Read, update, and delete are completely denied for privacy & security
      allow read, update, delete: if false;
    }
  }
}
